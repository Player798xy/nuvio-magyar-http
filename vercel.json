{
  "version": 2,
  "regions": ["fra1"],
  "functions": {
    "api/index.js": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/logo.png", "destination": "/api/index.js" },
    { "source": "/icon.png", "destination": "/api/index.js" },
    { "source": "/logo.svg", "destination": "/api/index.js" },
    { "source": "/channels/:path*", "destination": "/api/index.js" },
    { "source": "/api/live/:path*", "destination": "/api/index.js" },
    { "source": "/hls/live/:path*", "destination": "/api/index.js" },
    { "source": "/api/:path*", "destination": "/api/index.js" },
    { "source": "/manifest.json", "destination": "/api/index.js" },
    { "source": "/:config/manifest.json", "destination": "/api/index.js" },
    { "source": "/catalog/:path*", "destination": "/api/index.js" },
    { "source": "/:config/catalog/:path*", "destination": "/api/index.js" },
    { "source": "/meta/:path*", "destination": "/api/index.js" },
    { "source": "/:config/meta/:path*", "destination": "/api/index.js" },
    { "source": "/stream/:path*", "destination": "/api/index.js" },
    { "source": "/:config/stream/:path*", "destination": "/api/index.js" },
    { "source": "/configure", "destination": "/api/index.js" },
    { "source": "/:config/configure", "destination": "/api/index.js" },
    { "source": "/", "destination": "/api/index.js" }
  ]
}
