{
  "version": 2,
  "regions": ["fra1"],
  "functions": {
    "api/index.js": {
      "maxDuration": 30
    }
  },
  "headers": [
    {
      "source": "/(logo\\.png|icon\\.png|logo\\.svg|favicon\\.ico|qr\\.js|channels/.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=604800"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        }
      ]
    },
    {
      "source": "/configure",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        }
      ]
    },
    {
      "source": "/:config/configure",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        }
      ]
    },
    {
      "source": "/(uj-link|uj-link\\.html)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, s-maxage=3600, stale-while-revalidate=86400"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        }
      ]
    }
  ],
  "rewrites": [
    { "source": "/uj-link", "destination": "/uj-link.html" },
    { "source": "/robots.txt", "destination": "/api/index.js" },
    { "source": "/sitemap.xml", "destination": "/api/index.js" },
    { "source": "/proxy/:path*", "destination": "/api/index.js" },
    { "source": "/playlist.xspf", "destination": "/api/index.js" },
    { "source": "/playlist.m3u", "destination": "/api/index.js" },
    { "source": "/playlist.m3u8", "destination": "/api/index.js" },
    { "source": "/api/live/:path*", "destination": "/api/index.js" },
    { "source": "/hls/live/:path*", "destination": "/api/index.js" },
    { "source": "/api/:path*", "destination": "/api/index.js" },
    { "source": "/manifest.json", "destination": "/api/index.js" },
    { "source": "/:config/manifest.json", "destination": "/api/index.js" },
    { "source": "/catalog/:path*", "destination": "/api/index.js" },
    { "source": "/:config/catalog/:path*", "destination": "/api/index.js" },
    { "source": "/meta/:path*", "destination": "/api/index.js" },
    { "source": "/:config/meta/:path*", "destination": "/api/index.js" },
    { "source": "/subtitles/:path*", "destination": "/api/index.js" },
    { "source": "/:config/subtitles/:path*", "destination": "/api/index.js" },
    { "source": "/stream/:path*", "destination": "/api/index.js" },
    { "source": "/:config/stream/:path*", "destination": "/api/index.js" },
    { "source": "/configure", "destination": "/api/index.js" },
    { "source": "/:config/configure", "destination": "/api/index.js" },
    { "source": "/", "destination": "/api/index.js" }
  ]
}
